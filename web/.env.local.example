# Where the FastAPI AG-UI endpoint lives. The Next.js runtime calls this
# server-to-server, so the Python service needs no CORS configuration.
AGUI_URL=http://localhost:8000/agui

# CopilotKit's runtime phones home by default. This is a private portfolio app;
# leave this on unless you want that.
COPILOTKIT_TELEMETRY_DISABLED=true
