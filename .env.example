# Copy to .env and fill in, or let the setup wizard write .env for you.
# Variables exported in your shell override .env.

# E-Trade API consumer key (developer.etrade.com).
# Required.
ETRADE_CONSUMER_KEY=

# E-Trade API consumer secret, paired with the key above.
# Required.
ETRADE_CONSUMER_SECRET=

# true for E-Trade's sandbox; false for your real account (needs production keys).
ETRADE_SANDBOX=true

# LLM provider: anthropic | openai | local (an OpenAI-compatible server: MLX, Ollama, llama.cpp, ...).
LLM_PROVIDER=anthropic

# Model for the chat agent.
LLM_CHAT_MODEL=claude-opus-5

# Model for scheduled signal synthesis.
LLM_SYNTHESIS_MODEL=claude-sonnet-5

# Anthropic API key.
# Required when LLM_PROVIDER (or a task's override) is anthropic.
ANTHROPIC_API_KEY=

# OpenAI API key (also: uv sync --extra openai).
# Required when LLM_PROVIDER (or a task's override) is openai.
OPENAI_API_KEY=

# Provider local: which OpenAI-compatible server runs the model.
LOCAL_LLM_SERVER=mlx

# Provider local: the server's OpenAI-compatible endpoint, ending in /v1.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# Provider local: the model id the server knows (a Hugging Face repo, an Ollama tag), for every task routed to it.
LOCAL_LLM_MODEL=mlx-community/Qwen3-14B-4bit

# Provider local: a different model for the chat agent; blank uses LOCAL_LLM_MODEL.
LOCAL_LLM_MODEL_CHAT=

# Provider local: a different model for the signal synthesizer; blank uses LOCAL_LLM_MODEL.
LOCAL_LLM_MODEL_SYNTHESIZER=

# Provider local: the model family, for thinking and token counting; blank matches it from the model id.
LOCAL_LLM_MODEL_FAMILY=

# Provider local: request timeout; a large model's first token can take tens of seconds.
LOCAL_LLM_TIMEOUT_SECONDS=180

# Prompt tokens per request for hosted providers; archived memory fills what the prompt leaves.
LLM_CONTEXT_BUDGET=120000

# Provider local: prompt tokens per request; cut to fit the context window the server reports.
LOCAL_LLM_CONTEXT_BUDGET=24000

# Provider for the chat agent; blank uses LLM_PROVIDER.
LLM_PROVIDER_CHAT=

# Provider for the signal synthesizer; blank uses LLM_PROVIDER.
LLM_PROVIDER_SYNTHESIZER=

# SQLAlchemy async database URL.
DATABASE_URL=sqlite+aiosqlite:///data/agent.db

# Most tickers the watchlist can hold; adds beyond it are rejected.
WATCHLIST_MAX_SIZE=50

# Minutes between price refreshes.
PRICE_POLL_MINUTES=5

# Minutes between portfolio refreshes.
PORTFOLIO_POLL_MINUTES=15

# Capture a portfolio history snapshot each time the API starts.
SNAPSHOT_ON_STARTUP=true

# Fernet key that keeps the E-Trade login across restarts; blank keeps tokens in memory only.
TOKEN_ENCRYPTION_KEY=

# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Interface the API binds to; keep it on loopback.
API_HOST=127.0.0.1

# Port the API listens on.
API_PORT=8000
